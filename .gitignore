*.py[cod]
*.pyo
*.pyd

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/

.coverage
.coverage.*
htmlcov/
coverage.xml
pytestdebug.log

*.egg-info/
.eggs/
pip-wheel-metadata/

